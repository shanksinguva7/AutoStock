# SQLite file used by the running app (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Secret used to sign JWTs. Use a long random string.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1h"
PORT=4000
# Demo admin created by `npm run db:seed` (documented in README). Change for any real deployment.
ADMIN_EMAIL="admin@autostock.local"
ADMIN_PASSWORD="Admin@12345"
